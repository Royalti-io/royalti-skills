  "claims": [
    {
      "id": "c0",
      "section": "DDEX standards",
      "claim": "DDEX publishes ERN, MEAD, PIE, DSR, MWDR, RDR, CDM, LRAW, RIN and AR as separate standards, indexed at kb.ddex.net/implementing-each-standard/.",
      "sourceId": 3,
      "locator": "Standards index listing",
      "verifiedOn": "2026-08-21",
      "verdict": "confirmed",
      "verificationNote": ""
    },
    {
      "id": "c1",
      "section": "DDEX standards",
      "claim": "ERN covers: Releases and resources, and the terms and conditions under which a DSP may make them available to consumers",
      "sourceId": 4,
      "locator": "ERN overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "confirmed",
      "verificationNote": ""
    },
    {
      "id": "c2",
      "section": "DDEX standards",
      "claim": "MEAD covers: Rich supplementary metadata about parties, releases, resources and musical works \u2014 supplements the core supply-chain and rights data carried by ERN",
      "sourceId": 5,
      "locator": "MEAD overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "confirmed-after-correction",
      "verificationNote": "Original draft said 'editorial and marketing metadata beyond the release' and gave examples (moods, themes, focus tracks) not supported by the source. Examples cut; scope corrected \u2014 MEAD covers parties as well as content."
    },
    {
      "id": "c3",
      "section": "DDEX standards",
      "claim": "PIE covers: Rich information about Parties. Same role as MEAD, but PIE focuses on parties where MEAD focuses on content",
      "sourceId": 6,
      "locator": "PIE overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "confirmed-after-correction",
      "verificationNote": "Original draft claimed 'images, biography' \u2014 not stated in the source. Cut under cite-or-cut."
    },
    {
      "id": "c4",
      "section": "DDEX standards",
      "claim": "DSR covers: Sales and usage reports created by licensees (the digital services) and sent to licensors (the rights owners of works, recordings and videos). Flat-file; it replaced an XML-formatted report",
      "sourceId": 7,
      "locator": "DSR overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "confirmed",
      "verificationNote": "Flat-file-replaced-XML detail added from the source \u2014 materially useful and was missing."
    },
    {
      "id": "c5",
      "section": "DDEX standards",
      "claim": "MWDR covers: Obtaining licences for the mechanical right in musical works, for companies based in the US. Formerly the Works Notification and Licensing Standards",
      "sourceId": 8,
      "locator": "MWDR overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "refuted-and-rewritten",
      "verificationNote": "REFUTED. The draft described MWDR as general publishing-side work data \u2014 'musical works, writers, publishers, shares; the composition, not the recording'. The source scopes it to the mechanical right AND to US-based companies. Both scopes were dropped. This is the true-but-overgeneralised failure mode, on a standard the skill specifically highlights."
    },
    {
      "id": "c6",
      "section": "DDEX standards",
      "claim": "RDR covers: Data exchanged between music licensing companies, record companies and performer representatives \u2014 sound recordings, music videos, and the sales and usage data underpinning royalty calculation across territories",
      "sourceId": 9,
      "locator": "RDR overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "confirmed-after-correction",
      "verificationNote": "Draft said 'recording-side rights and ownership data' and used the term 'neighbouring rights', which the source does not. Term cut; the sales/usage-data half, which the draft omitted entirely, added."
    },
    {
      "id": "c7",
      "section": "DDEX standards",
      "claim": "CDM covers: Claims in musical works and the invoice calculations relating to them, exchanged between works rights owners or licensors and DSPs \u2014 plus a way for DSPs to flag discrepancies",
      "sourceId": 10,
      "locator": "CDM overview paragraph",
      "verifiedOn": "2026-08-21",
      "verdict": "refuted-and-rewritten",
      "verificationNote": "REFUTED. Draft said 'claims against usage' \u2014 vague, omitted that CDM is musical-works-specific, and dropped invoice calculations entirely."
    },
    {
      "id": "c8",
      "section": "DDEX standards",
      "claim": "LRAW covers: Communicating a link you have already established between a sound or video recording and the musical work(s) it embodies \u2014 including the negative case, that a work is *not* embodied",
      "sourceId": 11,
